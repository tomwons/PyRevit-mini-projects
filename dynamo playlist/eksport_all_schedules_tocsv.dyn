      "Outputs": [
        {
          "Id": "c67d97aa62f34c59a54ccebad0b6e6d2",
          "Name": "elements",
          "Description": "Wszystkie elementy w aktywnym dokumencie danej klasy.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
