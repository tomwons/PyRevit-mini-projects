      "Description": "Wszystkie elementy w aktywnym dokumencie danej klasy."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport os\r\n\r\n# Import Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Pobranie danych z wejść Dynamo\r\ninput_schedules = IN[0] if isinstance(IN[0], list) else [IN[0]]\r\nexport_folder = str(IN[1])\r\n\r\n# Sprawdzenie czy folder istnieje\r\nif not os.path.exists(export_folder):\r\n    os.makedirs(export_folder)\r\n\r\nresults = []\r\n\r\n# Konfiguracja eksportu\r\nopt = ViewScheduleExportOptions()\r\nopt.FieldDelimiter = \",\"\r\nopt.ExportHeadersFooter = False\r\nopt.ColumnHeaders = ExportColumnHeaders.OneRow\r\n\r\nfor item in input_schedules:\r\n    # Odpakowanie elementu z Dynamo do Revit API\r\n    if hasattr(item, \"InternalElement\"):\r\n        sched = item.InternalElement\r\n    else:\r\n        sched = item\r\n\r\n    # Sprawdzenie czy to na pewno ViewSchedule (pomijamy filtr nazwy)\r\n    if isinstance(sched, ViewSchedule):\r\n        try:\r\n            # Czyszczenie nazwy pliku ze znaków zakazanych\r\n            clean_name = \"\".join([c for c in sched.Name if c.isalnum() or c in (' ', '_')]).strip()\r\n            filename = clean_name + \".csv\"\r\n            full_path = os.path.join(export_folder, filename)\r\n            \r\n            # 1. Eksport standardowy\r\n            sched.Export(export_folder, filename, opt)\r\n            \r\n            # 2. MECHANICZNE USUNIĘCIE PIERWSZEGO WIERSZA (Tytułu)\r\n            with open(full_path, 'r') as f:\r\n                lines = f.readlines()\r\n            \r\n            # Nadpisujemy plik bez pierwszej linii\r\n            if len(lines) > 1:\r\n                with open(full_path, 'w') as f:\r\n                    f.writelines(lines[1:])\r\n            \r\n            results.append(\"OK (Wyczyszczono): \" + filename)\r\n        except Exception as e:\r\n            results.append(\"Błąd w {}: {}\".format(sched.Name, str(e)))\r\n    else:\r\n        results.append(\"Pominięto: Element nie jest zestawieniem.\")\r\n\r\nOUT = results",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b17366edae3b4cd2acbed8796a28a286",
